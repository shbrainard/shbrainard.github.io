---
interface Props {
  title: string;
  type?: string;
  venue?: string;
  date: Date;
  location?: string;
  body: string;
}

const { title, venue, date, body } = Astro.props;
const year = date.getFullYear();
---

<article class="border-b border-slate-100 py-5 last:border-0">
  <h3 class="text-base font-semibold text-slate-900">{title}</h3>
  {venue && (
    <p class="mt-1 text-sm text-slate-500">{venue} ({year})</p>
  )}
  <div class="mt-2 text-sm text-slate-700 prose prose-sm prose-slate prose-a:text-blue-600 max-w-none" set:html={body} />
</article>
